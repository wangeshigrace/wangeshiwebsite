{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.imwangeshi.site"
        }
      ],
      "destination": "https://imwangeshi.site/:1",
      "permanent": true
    }
  ]
}
{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.imwangeshi.site"
        }
      ],
      "destination": "https://imwangeshi.site/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}
